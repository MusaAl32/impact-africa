                "required": [
                  "id",
                  "title",
                  "description",
                  "category",
                  "country",
                  "region",
                  "status",
                  "severity",
                  "opportunityScore",
                  "evidence",
                  "publishedAt",
                  "updatedAt",
                  "sourceUrl",
                  "publicUrl"
                ]
              }
