{
  "version": 1,
  "sdk_version": "1.0.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "africa-opportunity-hub",
      "version": "0.1.0",
      "title": "Africa Opportunity Hub"
    },
    "tools": [
      {
        "name": "list_problems",
        "title": "List public problems and opportunities",
        "description": "Search the Africa Opportunity Hub's published problem/opportunity records. Read-only and public data only: no submissions, contact details or unpublished records. Supports country, category, keyword, status and pagination filters.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free-text match on title or description.",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "country": {
              "description": "Country name, e.g. Kenya.",
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "category": {
              "description": "Sector/category, e.g. Agriculture.",
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "status": {
              "default": "published",
              "description": "Only 'published' records are exposed publicly.",
              "type": "string",
              "const": "published"
            },
            "limit": {
              "default": 10,
              "description": "Maximum rows to return (1-50, default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "offset": {
              "default": 0,
              "description": "Rows to skip for pagination (0-5000, default 0).",
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "problems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  },
                  "region": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": "string"
                  },
                  "severity": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "opportunityScore": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "publishedAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "updatedAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourceUrl": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "publicUrl": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "category",
                  "country",
                  "region",
                  "status",
                  "severity",
                  "opportunityScore",
                  "evidence",
                  "publishedAt",
                  "updatedAt",
                  "sourceUrl",
                  "publicUrl"
                ]
              }
            },
            "pagination": {
              "type": "object",
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "offset": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "returned": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "hasMore": {
                  "type": "boolean"
                }
              },
              "required": [
                "limit",
                "offset",
                "returned",
                "hasMore"
              ]
            },
            "error": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "not_found",
                        "no_results",
                        "rate_limited",
                        "internal_error"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "problems",
            "pagination",
            "error"
          ]
        }
      },
      {
        "name": "list_research",
        "title": "List research entries",
        "description": "Search the Africa Opportunity Map research library of abstracts, sources and publication years.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free-text match on title or abstract.",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "country": {
              "description": "Filter by country or scope.",
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "category": {
              "description": "Filter by category.",
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "limit": {
              "default": 10,
              "description": "Maximum number of entries to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "research": {
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "research"
          ]
        }
      },
      {
        "name": "analyze_entry",
        "title": "Analyse an entry with Nuru AI",
        "description": "Run a Nuru AI specialist analysis on a problem or research entry: context, root drivers, opportunity, who should build it, and a first-90-days plan.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "itemType": {
              "type": "string",
              "enum": [
                "problem",
                "research"
              ],
              "description": "Which table the entry lives in."
            },
            "itemId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The entry id from list_problems or list_research."
            },
            "department": {
              "default": "business",
              "description": "Which Nuru AI department should analyse the entry.",
              "type": "string",
              "enum": [
                "platform",
                "business",
                "agriculture",
                "research",
                "education",
                "developer",
                "creative",
                "documents"
              ]
            }
          },
          "required": [
            "itemType",
            "itemId"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "department": {
              "type": "string"
            },
            "analysis": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "department",
            "analysis"
          ]
        }
      }
    ]
  }
}
